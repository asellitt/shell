[[ "$ZSH_PROFILE" == "1" ]] && zmodload zsh/zprof

source "${HOME}/.header" 2>/dev/null || true

export PATH="${HOME}/path:${HOME}/.git-commands:${PATH}"

# Brew shell completion (macOS only)
if type brew &>/dev/null; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

autoload -Uz compinit && compinit

export ZSH="${HOME}/.oh-my-zsh"
ZSH_THEME="asellitt"

plugins=(
  asdf
  git
  github
  bundler
  direnv
)

source "${ZSH}/oh-my-zsh.sh"

eval "$(zoxide init zsh)"

[[ -f "${HOME}/.functions" ]] && source "${HOME}/.functions"
[[ -f "${HOME}/.aliases"   ]] && source "${HOME}/.aliases"
[[ -f "${HOME}/.aliases.machinespecific" ]] && source "${HOME}/.aliases.machinespecific"

if type fzf &>/dev/null; then
  source <(fzf --zsh)
fi

[[ -e "${HOME}/.nix-profile/etc/profile.d/nix.sh" ]] && \
  source "${HOME}/.nix-profile/etc/profile.d/nix.sh"

export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
