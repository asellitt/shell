function fuck() {
  killall -9 $2;
  if [[ $? -eq 0 ]]; then
    tableflip $2
  fi
}

function tableflip() {
  echo
  echo " (╯°□°）╯︵$(echo $1|flip)"
  echo
}

function killport() {
  kill -9 $( lsof -i:$1 -t )
}

function timeshell() {
  local shell=${1-$SHELL}
  for i in $(seq 1 10); do
    /usr/bin/time $shell -i -c exit | grep real
  done
}

function fix-self-assigned-ip {
  sudo rm /Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist*
  sudo rm /Library/Preferences/SystemConfiguration/NetworkInterfaces.plist*
  sudo rm /Library/Preferences/SystemConfiguration/preferences.plist*
}

function tabname() {
  echo -ne "\033]0;$@\007"
}

function findhistory() {
  history | grep -i "$@" ;
}

# ── Bitwarden SSH helpers ──────────────────────────────────────────────────────
# Requires: bw (Bitwarden CLI), jq, sshpass
# ──────────────────────────────────────────────────────────────────────────────

_bw_save_session() {
  echo "$BW_SESSION" > ~/.bw_session
  chmod 600 ~/.bw_session
}

# Checks whether the BW vault is unlocked, and if not, brings it to that state.
# BW_SESSION is exported into the current shell so subsequent bw calls in this
# session don't need to unlock again.
_bw_ensure_session() {
  local bw_status
  bw_status=$(bw status 2>/dev/null | jq -r '.status')

  case "$bw_status" in
    unauthenticated)
      echo "[bw] Not logged in — starting login..." >&2
      local session
      session=$(bw login --raw 2>/dev/tty)
      if [[ -z "$session" ]]; then
        echo "[bw] Login failed." >&2
        return 1
      fi
      export BW_SESSION="$session"
      _bw_save_session
      echo "[bw] Logged in." >&2
      ;;
    locked)
      local pw session
      echo -n "[bw] Vault locked. Master password: " >&2
      read -rs pw
      echo >&2  # newline after hidden input
      session=$(BW_MASTER_PW="$pw" bw unlock --passwordenv BW_MASTER_PW --raw 2>/dev/null)
      unset pw
      if [[ -z "$session" ]]; then
        echo "[bw] Unlock failed — wrong password?" >&2
        return 1
      fi
      export BW_SESSION="$session"
      _bw_save_session
      echo "[bw] Vault unlocked." >&2
      ;;
    unlocked)
      : # Nothing to do
      ;;
    *)
      echo "[bw] Unexpected bw status: '$status'" >&2
      return 1
      ;;
  esac
}

_bw_ssh() {
  local uuid="$1" host="$2"
  shift 2  # remaining args passed through to ssh

  _bw_ensure_session || return 1

  local pw
  pw=$(bw get password "$uuid" 2>/dev/null)

  if [[ -z "$pw" ]]; then
    echo "[bw] Could not fetch password for $host (UUID: $uuid)" >&2
    return 1
  fi

  if command -v pbcopy &>/dev/null; then
    echo -n "$pw" | pbcopy
  fi

  SSHPASS="$pw" sshpass -e ssh "$host" "$@"
  local exit_code=$?
  unset pw
  return $exit_code
}